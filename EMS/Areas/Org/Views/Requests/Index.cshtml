@model RequestsPage
@{
    ViewData["Title"] = "Leave & resignations";
    var pendingResignations = Model.Resignations.Count(r => r.Status == ResignationStatus.Pending);
    var onNotice = Model.Resignations.Where(r => r.Status == ResignationStatus.Accepted && r.LastWorkingDay >= DateOnly.FromDateTime(AppClock.Today)).ToList();
    List<EMS.Models.Admin.StatTile> stats =
    [
        new("Leave to approve", Model.PendingLeave.Count.ToString(), $"{Model.PendingLeave.Sum(a => a.TotalDays):0.#} days in total"),
        new("Resignations to review", pendingResignations.ToString()),
        new("On notice", onNotice.Count.ToString(), onNotice.Count > 0 ? $"Next leaves {onNotice.Min(r => r.LastWorkingDay)!.Value.ToShortDate()}" : "Nobody serving notice"),
        new("Documents to verify", Model.DocumentsToVerify.Count.ToString(), "Joining documents from employees"),
    ];
}

<header class="page-head">
    <div>
        <h1>Leave &amp; resignations</h1>
        <p>Verify joining documents, approve leave (the days are marked "On leave" in attendance) and accept resignations with the last working day.</p>
    </div>
</header>

<partial name="_Stats" model="stats" />

@if (Model.DocumentsToVerify.Count > 0)
{
    <section class="card">
        <div class="card-head"><h2>Joining documents to verify</h2><span>Check each against the original</span></div>
        <div class="table-wrap">
            <table>
                <thead><tr><th>Employee</th><th>Document</th><th>Uploaded</th><th></th></tr></thead>
                <tbody>
                    @foreach (var d in Model.DocumentsToVerify)
                    {
                        <tr>
                            <td>@d.Employee.FullName<small>@d.Employee.EmpCode</small></td>
                            <td>@d.Type.DisplayName()<small><a asp-controller="Employees" asp-action="Document" asp-route-id="@d.EmployeeId" asp-route-documentId="@d.UniqueId" target="_blank">@d.OriginalName</a></small></td>
                            <td>@d.CreatedAt.ToAppTime().ToShortDate()</td>
                            <td>
                                <form method="post" asp-controller="Employees" asp-action="ReviewDocument" asp-route-id="@d.EmployeeId" asp-route-documentId="@d.UniqueId" asp-route-returnTo="requests" class="decide">
                                    <input name="note" maxlength="500" placeholder="Note (needed to reject)" aria-label="Note" />
                                    <button type="submit" name="verify" value="true" class="btn btn-sm">Verify</button>
                                    <button type="submit" name="verify" value="false" class="btn btn-danger btn-sm">Reject</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}

<section class="card">
    <div class="card-head"><h2>Leave waiting for approval</h2><span>@Model.PendingLeave.Count application@(Model.PendingLeave.Count == 1 ? "" : "s")</span></div>
    @if (Model.PendingLeave.Count == 0)
    {
        <p class="empty">No leave is waiting for approval.</p>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead><tr><th>Employee</th><th>Dates</th><th>Type</th><th class="num">Days</th><th></th></tr></thead>
                <tbody>
                    @foreach (var a in Model.PendingLeave)
                    {
                        <tr>
                            <td>@a.Employee.FullName<small>@a.Employee.EmpCode · applied @a.AppliedOn.ToAppTime().ToShortDate()</small></td>
                            <td>@a.FromDate.ToString("dd MMM")@(a.ToDate != a.FromDate ? $" – {a.ToDate:dd MMM}" : "") @a.ToDate.Year<small>@a.Reason</small></td>
                            <td>@a.LeaveType.Name@(a.IsHalfDay ? " (half day)" : "")</td>
                            <td class="num">@a.TotalDays.ToString("0.#")</td>
                            <td>
                                <form method="post" asp-action="Leave" asp-route-id="@a.UniqueId" class="decide">
                                    <input name="remarks" maxlength="500" placeholder="Remarks (optional)" aria-label="Remarks" />
                                    <button type="submit" name="approve" value="true" class="btn btn-sm">Approve</button>
                                    <button type="submit" name="approve" value="false" class="btn btn-danger btn-sm">Reject</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="card">
    <div class="card-head"><h2>Resignations</h2><span>Waiting and on notice</span></div>
    @if (Model.Resignations.Count == 0)
    {
        <p class="empty">No resignations.</p>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead><tr><th>Employee</th><th>Submitted</th><th>Last day</th><th>Status</th><th></th></tr></thead>
                <tbody>
                    @foreach (var r in Model.Resignations)
                    {
                        <tr>
                            <td>@r.Employee.FullName<small>@r.Employee.EmpCode · @r.Employee.NoticePeriodDays-day notice</small></td>
                            <td>@r.SubmittedAt.ToAppTime().ToShortDate()<small>@r.Reason</small></td>
                            <td>@((r.LastWorkingDay ?? r.RequestedLastDay).ToShortDate())<small>@(r.LastWorkingDay is null ? "Asked for" : "Confirmed")</small></td>
                            <td><span class="badge @(r.Status == ResignationStatus.Pending ? "badge-blue" : "badge-orange")">@(r.Status == ResignationStatus.Pending ? "Waiting" : "On notice")</span></td>
                            <td>
                                @if (r.Status == ResignationStatus.Pending)
                                {
                                    <form method="post" asp-action="Resignation" asp-route-id="@r.UniqueId" class="decide">
                                        <input type="date" name="lastWorkingDay" value="@r.RequestedLastDay.ToString("yyyy-MM-dd")" aria-label="Last working day" title="Last working day" />
                                        <input name="remarks" maxlength="500" placeholder="Remarks (optional)" aria-label="Remarks" />
                                        <button type="submit" name="accept" value="true" class="btn btn-sm">Accept</button>
                                        <button type="submit" name="accept" value="false" class="btn btn-danger btn-sm">Reject</button>
                                    </form>
                                }
                                else
                                {
                                    <div class="row-actions"><a class="btn btn-secondary btn-sm" asp-controller="Letters" asp-action="Relieving" asp-route-employeeId="@r.EmployeeId">Relieving letter</a></div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@if (Model.RecentLeave.Count > 0)
{
    <section class="card">
        <div class="card-head"><h2>Recently decided leave</h2></div>
        <div class="table-wrap">
            <table>
                <thead><tr><th>Employee</th><th>Dates</th><th>Type</th><th class="num">Days</th><th>Decision</th></tr></thead>
                <tbody>
                    @foreach (var a in Model.RecentLeave)
                    {
                        <tr>
                            <td>@a.Employee.FullName<small>@a.Employee.EmpCode</small></td>
                            <td>@a.FromDate.ToString("dd MMM")@(a.ToDate != a.FromDate ? $" – {a.ToDate:dd MMM}" : "")</td>
                            <td>@a.LeaveType.Name</td>
                            <td class="num">@a.TotalDays.ToString("0.#")</td>
                            <td><span class="badge @(a.Status == LeaveStatus.Approved ? "badge-green" : "badge-orange")">@a.Status</span><small>@a.ApproverRemarks</small></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}
