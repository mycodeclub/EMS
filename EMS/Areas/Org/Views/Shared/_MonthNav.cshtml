@model DateOnly
@{
    // Previous / next month links for the current action; the current month is the latest.
    var action = ViewContext.RouteData.Values["action"] as string;
    var previous = Model.AddMonths(-1);
    var next = Model.AddMonths(1);
    var hasNext = next <= DateOnly.FromDateTime(AppClock.Today);
}
<nav class="month-nav" aria-label="Month">
    <a class="btn btn-secondary btn-sm" asp-action="@action" asp-route-year="@previous.Year" asp-route-month="@previous.Month" aria-label="Previous month">‹ @previous.ToString("MMM")</a>
    <strong>@Model.ToString("MMMM yyyy")</strong>
    @if (hasNext)
    {
        <a class="btn btn-secondary btn-sm" asp-action="@action" asp-route-year="@next.Year" asp-route-month="@next.Month" aria-label="Next month">@next.ToString("MMM") ›</a>
    }
    else
    {
        <span class="btn btn-secondary btn-sm" aria-disabled="true" style="opacity:.4">@next.ToString("MMM") ›</span>
    }
</nav>
