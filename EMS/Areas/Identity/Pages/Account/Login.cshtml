@page
@model LoginModel
@{
    ViewData["Title"] = "Sign in";
    ViewData["AuthAside"] = true;
    ViewData["AsideTitle"] = "Welcome back.";
    ViewData["AsideText"] = "Every shift. Every office. One system — attendance, shifts and leave in one place.";
}

<div class="auth-heading">
    <h1>Sign in</h1>
    <p>Use your work email to access EMS.</p>
</div>

<form id="account" method="post" class="auth-form">
    <div asp-validation-summary="ModelOnly" class="auth-alert" role="alert"></div>

    <div class="form-floating">
        <input asp-for="Input.Email" class="form-control" type="email" autocomplete="username" inputmode="email" aria-required="true" placeholder="name@company.com" />
        <label asp-for="Input.Email">Work email</label>
        <span asp-validation-for="Input.Email" class="field-error"></span>
    </div>
    <div class="form-floating">
        <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Password" />
        <label asp-for="Input.Password">Password</label>
        <span asp-validation-for="Input.Password" class="field-error"></span>
    </div>

    <div class="auth-row">
        <div class="form-check">
            <input class="form-check-input" asp-for="Input.RememberMe" />
            <label class="form-check-label" asp-for="Input.RememberMe">Keep me signed in</label>
        </div>
        <a id="forgot-password" asp-page="./ForgotPassword">Forgot password?</a>
    </div>

    <button id="login-submit" type="submit" class="btn btn-primary btn-lg w-100">Sign in</button>
</form>

@if ((Model.ExternalLogins?.Count ?? 0) > 0)
{
    <div class="auth-divider"><span>or</span></div>
    <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="auth-external">
        @foreach (var provider in Model.ExternalLogins!)
        {
            <button type="submit" class="btn btn-outline-secondary btn-lg w-100" name="provider" value="@provider.Name" title="Sign in with @provider.DisplayName">Continue with @provider.DisplayName</button>
        }
    </form>
}

@if (Model.Demo.Enabled)
{
    <section class="auth-demo" aria-labelledby="demo-title">
        <h2 id="demo-title">Try the live demo</h2>
        <p>Sign in to <b>@EMS.Services.Demo.DemoSeeder.OrganizationName</b> as any role. Password for all: <code>@Model.Demo.Password</code>. Changes are reset every midnight.</p>
        <div class="auth-demo-list">
            @foreach (var login in EMS.Services.Demo.DemoSeeder.Logins)
            {
                <button type="button" class="auth-demo-login" data-email="@login.Email" data-password="@Model.Demo.Password" title="@login.Description">
                    <b>@login.Label</b>
                    <span>@login.Email</span>
                </button>
            }
        </div>
    </section>
}

<p class="auth-switch">New to EMS? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Create an account</a></p>
<p class="auth-small"><a id="resend-confirmation" asp-page="./ResendEmailConfirmation">Didn't get the confirmation email?</a></p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Demo logins: fill the form and sign in.
        document.querySelectorAll('.auth-demo-login').forEach(button => button.addEventListener('click', () => {
            document.getElementById('Input_Email').value = button.dataset.email;
            document.getElementById('Input_Password').value = button.dataset.password;
            document.getElementById('account').requestSubmit();
        }));
    </script>
}
