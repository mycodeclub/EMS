@model ChangePasswordInput
@{
    ViewData["Title"] = "Choose your password";
}

<partial name="_Stepper" />

<h1>Welcome! First, choose your own password</h1>
<p class="lead">You signed in with a temporary password from your welcome email. Replace it with one only you know.</p>

<section class="card form-card" style="max-width:520px">
    <form asp-action="Password" method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="alert alert-error"></div>
        <div class="form-grid" style="grid-template-columns:1fr">
            <div class="field">
                <label asp-for="NewPassword"></label>
                <input asp-for="NewPassword" autocomplete="new-password" />
                <span class="hint">At least 8 characters, with upper and lower case letters, a number and a symbol.</span>
                <span asp-validation-for="NewPassword"></span>
            </div>
            <div class="field">
                <label asp-for="ConfirmPassword"></label>
                <input asp-for="ConfirmPassword" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword"></span>
            </div>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn">Save password &amp; continue</button>
        </div>
    </form>
</section>
