@model ProfileInput
@{
    ViewData["Title"] = "Organization profile";
}

<partial name="_Stepper" />

<h1>Tell us about your organization</h1>
<p class="lead">These details appear on salary slips and reports. You can change them later from Organization profile.</p>

<section class="card form-card">
    <form asp-action="Profile" method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="alert alert-error"></div>
        <partial name="_ProfileFields" model="Model" />
        <div class="form-actions">
            <button type="submit" class="btn">Save &amp; continue</button>
        </div>
    </form>
</section>
