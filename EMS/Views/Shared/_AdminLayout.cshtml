@using Microsoft.Extensions.Options
@using EMS.Models.Landing
@inject IOptions<CompanyOptions> CompanyOptions
@{
    // Layout for the super admin console (AdminController).
    var company = CompanyOptions.Value;
    var title = ViewData["Title"] as string;
    var action = ViewContext.RouteData.Values["action"] as string;
    (string Action, string Label)[] sections = [("Enquiries", "Enquiries"), ("Leads", "Leads"), ("Customers", "Active customers"), ("Billing", "Billing")];
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>@(title is null ? "Admin" : title) — @company.ProductName Admin</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href="~/img/logo.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="~/css/brand.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="admin-top">
        <div class="admin-bar">
            <a class="admin-brand" asp-controller="Admin" asp-action="Index">
                <img src="~/img/logo.svg" alt="" width="28" height="28" />
                <b>@company.ProductName</b><span>Admin</span>
            </a>
            <div class="admin-user">
                <span title="Signed in as">@User.Identity?.Name</span>
                <form method="post" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Content("~/")">
                    <button type="submit">Sign out</button>
                </form>
            </div>
        </div>
        <nav class="admin-nav" aria-label="Admin">
            @foreach (var (sectionAction, label) in sections)
            {
                <a asp-controller="Admin" asp-action="@sectionAction" aria-current="@(sectionAction == action ? "page" : null)">@label</a>
            }
        </nav>
    </header>
    <main id="main" class="admin-main">
        <p class="admin-notice" role="note">Sample data — these screens are not connected to the database yet.</p>
        @RenderBody()
    </main>
</body>
</html>
