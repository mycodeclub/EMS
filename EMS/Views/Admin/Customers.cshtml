@model CustomersPage
@using EMS.Services.Onboarding
@{
    ViewData["Title"] = "Customers & trials";
}

<header class="page-head">
    <div>
        <h1>Customers &amp; trials</h1>
        <p>Organizations on a free trial, and the customers using EMS today. <b>Sign in as admin</b> opens a customer's panel in a new tab; you stay signed in here.</p>
    </div>
    <div class="page-actions">
        @if (Model.Trials.Any(t => t.IsDemo))
        {
            <form method="post" asp-action="ResetDemo">
                <button type="submit" class="btn btn-secondary" title="Discard visitors' changes and rebuild the demo now">Reset demo now</button>
            </form>
        }
        <a class="btn" asp-action="OfferTrial">Offer a free trial</a>
    </div>
</header>

<section class="card">
    <div class="card-head">
        <h2>Free trials</h2>
        <span>@Model.Trials.Count organization@(Model.Trials.Count == 1 ? "" : "s") · live data</span>
    </div>
    @if (Model.Trials.Count == 0)
    {
        <div class="empty">
            <p>No free trials yet. Offer one from a lead or enquiry, or start one directly.</p>
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Organization</th>
                        <th>Owner login</th>
                        <th>Offered</th>
                        <th>Trial ends</th>
                        <th class="num">Employees</th>
                        <th>Onboarding</th>
                        <th><span class="sr-only">Panel</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var trial in Model.Trials)
                    {
                        var today = DateOnly.FromDateTime(AppClock.Today);
                        <tr>
                            <td>
                                @trial.Organization
                                @if (trial.IsDemo)
                                {
                                    <span class="badge badge-indigo">Demo</span>
                                }
                                <small>@trial.Industry?.DisplayName()</small>
                            </td>
                            <td>@trial.OwnerEmail</td>
                            <td>@trial.OfferedAt.ToAppTime().ToShortDate()</td>
                            @if (trial.IsDemo)
                            {
                                <td>—<small>Resets every midnight</small></td>
                            }
                            else
                            {
                                <td class="@(trial.TrialEndsOn < today ? "late" : null)">
                                    @trial.TrialEndsOn?.ToShortDate()
                                    @if (trial.TrialEndsOn is { } ends)
                                    {
                                        <small>@(ends < today ? "Expired" : $"{ends.DayNumber - today.DayNumber} days left")</small>
                                    }
                                </td>
                            }
                            <td class="num">@trial.Employees</td>
                            <td><partial name="_TrialStep" model="trial.Step" /></td>
                            <td class="num">
                                @if (trial.Step == OnboardingStep.Done)
                                {
                                    <form method="post" asp-action="SignInAs" asp-route-id="@trial.Id" target="_blank">
                                        <button type="submit" class="btn btn-secondary btn-sm" title="Open @trial.Organization's admin panel in a new tab, signed in as @trial.OwnerEmail">Sign in as admin ↗</button>
                                    </form>
                                }
                                else
                                {
                                    <span class="muted" title="The owner has not finished setup yet">Not set up</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<h2 class="form-section">Paying customers</h2>
<partial name="_NotStoredNotice" />
<partial name="_Stats" model="Model.Paying.Stats" />

<section class="card">
    <div class="card-head">
        <h2>Customers</h2>
        <span>@Model.Paying.Rows.Count organizations</span>
    </div>
    @if (Model.Paying.Rows.Count == 0)
    {
        <div class="empty">
            <p>No paying customers yet.</p>
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Organization</th>
                        <th>Plan</th>
                        <th class="num">Offices</th>
                        <th class="num">Employees</th>
                        <th>Customer since</th>
                        <th>Renews on</th>
                        <th class="num">Monthly value</th>
                        <th>Health</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Paying.Rows.OrderByDescending(r => r.MonthlyValue))
                    {
                        var badge = row.Health switch
                        {
                            CustomerHealth.Healthy => "badge-green",
                            CustomerHealth.Onboarding => "badge-blue",
                            _ => "badge-orange",
                        };
                        <tr>
                            <td>@row.Organization<small>@row.City · @row.Industry.DisplayName()</small></td>
                            <td>@row.Plan</td>
                            <td class="num">@row.Offices</td>
                            <td class="num">@row.Employees.ToString("N0")</td>
                            <td>@row.CustomerSince.ToShortDate()</td>
                            <td>@row.RenewsOn.ToShortDate()</td>
                            <td class="num">@(row.MonthlyValue == 0 ? "Free trial" : row.MonthlyValue.ToRupees())</td>
                            <td><span class="badge @badge">@row.Health.DisplayName()</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
