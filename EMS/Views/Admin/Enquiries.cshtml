@model OfferableList<EnquiryRow>
@{
    ViewData["Title"] = "Enquiries";
}

<header class="page-head">
    <div>
        <h1>Enquiries</h1>
        <p>Free-trial, demo and pricing requests from the website contact form.</p>
    </div>
</header>

<partial name="_SampleNotice" />

<partial name="_Stats" model="Model.Stats" />

<section class="card">
    <div class="card-head">
        <h2>Latest enquiries</h2>
        <span>@Model.Rows.Count enquiries</span>
    </div>
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Received</th>
                    <th>Contact</th>
                    <th>Organization</th>
                    <th>Team size</th>
                    <th>Interested in</th>
                    <th>Status</th>
                    <th><span class="sr-only">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Rows)
                {
                    var badge = row.Status switch
                    {
                        EnquiryStatus.New => "badge-blue",
                        EnquiryStatus.Contacted => "badge-orange",
                        EnquiryStatus.Converted => "badge-green",
                        _ => "",
                    };
                    <tr>
                        <td>@row.ReceivedAt.ToShortDate()<small>@row.ReceivedAt.ToString("h:mm tt")</small></td>
                        <td>@row.Name<small><a href="mailto:@row.Email">@row.Email</a> · @row.Phone</small></td>
                        <td>@row.Organization<small>@row.Industry.DisplayName()</small></td>
                        <td>@row.TeamSize.DisplayName()</td>
                        <td>@row.Interest.DisplayName()</td>
                        <td><span class="badge @badge">@row.Status.DisplayName()</span></td>
                        <td class="num"><partial name="_OfferAction" model="(row.Email, Model.OfferedEmails)" /></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
